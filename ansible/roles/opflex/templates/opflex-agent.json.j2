{
    "command": "neutron-opflex-agent --config-file /etc/neutron/neutron.conf --config-file /etc/neutron/opflex_agent.ini --log-file /var/log/kolla/opflex/opflex-agent.log",
    "config_files": [
        {
            "source": "{{ container_config_directory }}/neutron.conf",
            "dest": "/etc/neutron/neutron.conf",
            "owner": "opflex",
            "perm": "0600"
        },
        {
            "source": "{{ container_config_directory }}/opflex_agent.ini",
            "dest": "/etc/neutron/opflex_agent.ini",
            "owner": "opflex",
            "perm": "0600"
        }
    ],
    "directories": [
        {
            "path": "/var/log/kolla/opflex",
            "owner": "opflex:opflex",
            "perm": "0755",
            "recurse": true
        },
        {
            "path": "{{ opflex_drop_log_watch_dir }}",
            "owner": "opflex:opflex",
            "perm": "0755",
            "recurse": true
        },
        {
            "path": "{{ opflex_agent_ovs_state_dir }}/tmp",
            "owner": "opflex:opflex",
            "perm": "0755",
            "recurse": false
        }
    ]
}
